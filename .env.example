# === База данных ===
# local
DATABASE_URL=postgresql+asyncpg://your_user_name:your_user_pass@localhost:5432/support_db
# CHANGE for Docker deployment
# DATABASE_URL=postgresql+asyncpg://your_user_name:your_user_pass@db:5432/support_db

# Отдельные компоненты (опционально)
DB_USER=your_user_name
DB_PASSWORD=your_user_pass
DB_NAME=support_db
DB_HOST=localhost # for Docker -> db
DB_PORT=5432

# === Ollama / LLM ===
OLLAMA_BASE_URL=http://localhost:11434
# CHANGE for Docker deployment (localhost Ollama)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Модель для генерации ответов
LLM_MODEL=llama3.1:latest

# Температура генерации
LLM_TEMPERATURE=0.1

# Максимальное число токенов в ответе модели
LLM_MAX_TOKENS=2048

# === LangSmith (мониторинг и трейсинг) ===
LANGSMITH_TRACING=false

# API ключ для аутентификации в LangSmith
LANGSMITH_API_KEY=

# Имя проекта в дашборде LangSmith
LANGSMITH_PROJECT=support-ai

# Эндпоинт для обращения к LangSmith
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Приложение ===
# Хост и порт для Uvicorn (веб-сервер)
APP_HOST=0.0.0.0
APP_PORT=8080

# Режим запуска: dev (с авто-релоадом) или prod
APP_ENV=dev # !!!for Docker -> prod

# Секретный ключ для подписи токенов и сессий
# Сгенерируйте безопасное значение:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# === Telegram (алерты для критичных заявок) ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID пользователя/канала для получения уведомлений
# Получите через @userinfobot
TELEGRAM_CHAT_ID=

# Порог приоритета для отправки алертов (critical/high/medium/low)
ALERT_PRIORITY_THRESHOLD=critical

# === Безопасность ===
# Разрешённые источники для CORS (укажите фронтенд, если есть)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8080"]'

# Лимит запросов в минуту на одного пользователя (rate limiting)
RATE_LIMIT_PER_MINUTE=60

# === RAG / Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=support_ai_kb
RAG_TOP_K=3
RAG_EMBED_MODEL=all-MiniLM-L6-v2
RAG_MAX_FOLLOWUP_TURNS=2
RAG_DOCS_PATH=data/rag_docs